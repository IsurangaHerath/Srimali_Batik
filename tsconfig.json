{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/public/src/shared/*"],
      "@storefront/*": ["src/public/src/storefront/*"],
      "@admin/*": ["src/public/src/admin/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "public/dist"]
}
